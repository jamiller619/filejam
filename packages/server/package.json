{
  "name": "@files/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scanner": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -b --noEmit",
    "clean": "tsc -b --clean",
    "db:generate": "drizzle-kit generate",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "copy:migrations": "node scripts/copy-migrations.mjs",
    "build:config": "npx json2ts src/config/config.schema.json src/config/schema.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/write-file-atomic": "^4.0.3",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "env-paths": "^4.0.0",
    "fdir": "^6.5.0",
    "file-entry-cache": "^11.1.5",
    "find-up-simple": "^1.0.1",
    "mime": "^4.0.7",
    "json-schema-to-typescript": "^16.0.0",
    "rotating-file-stream": "^3.2.10",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.5"
  }
}
