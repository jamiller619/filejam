{
  "name": "@filejam/preview-video",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "filejamApp": {
    "type": "preview",
    "apiVersion": 1,
    "extensions": [
      "mp4",
      "m4v",
      "mov",
      "mkv",
      "webm",
      "avi",
      "mpeg",
      "mpg",
      "ts",
      "mts",
      "m2ts",
      "3gp",
      "ogv",
      "wmv"
    ],
    "mimeTypes": [
      "video/mp4",
      "video/quicktime",
      "video/x-matroska",
      "video/webm",
      "video/x-msvideo",
      "video/mpeg",
      "video/mp2t",
      "video/3gpp",
      "video/ogg",
      "video/x-ms-wmv"
    ],
    "capabilities": {
      "original": false
    }
  },
  "dependencies": {
    "@filejam/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
