{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.cts"],
  "references": [
    {
      "path": "../../packages/server"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/preview-api"
    },
    {
      "path": "../../packages/preview-images"
    },
    {
      "path": "../../packages/preview-video"
    }
  ]
}
