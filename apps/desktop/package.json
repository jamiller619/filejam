{
  "name": "@files/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && pnpm --filter @files/server copy:migrations && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b --noEmit",
    "clean": "tsc -b --clean",
    "start": "pnpm build && node scripts/start.mjs",
    "copy:assets": "node scripts/copy-assets.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs && node tests/run-smoke.mjs",
    "dev": "tsc -b && pnpm --filter @files/server copy:migrations && node scripts/dev.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@files/plugin-api": "workspace:*",
    "@files/preview-images": "workspace:*",
    "@files/preview-video": "workspace:*",
    "@files/server": "workspace:*",
    "@files/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.22",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ffmpeg-static": "5.3.0",
    "inline-css-modules": "^0.3.0",
    "masonic": "^4.1.0",
    "mime": "^4.0.7",
    "motion": "^14.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.5",
    "react-router": "^8.4.0"
  },
  "main": "dist/index.js"
}
