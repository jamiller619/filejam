{
  "name": "filejam",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "poc:test": "node apps/desktop/scripts/test-live-browser.mjs",
    "poc:bench": "pnpm poc:service:build && pnpm build && node apps/desktop/tests/run-live-browser-bench.mjs",
    "build": "node apps/desktop/scripts/generate-settings.mjs && tsc -b && pnpm --filter @filejam/server copy:migrations && pnpm --filter @filejam/desktop copy:assets",
    "poc:live": "pnpm poc:service:build && pnpm build && node apps/desktop/scripts/run-live-browser.mjs",
    "poc:service:build": "cargo build --release --manifest-path packages/fs-service/Cargo.toml",
    "poc:service:test": "cargo test --manifest-path packages/fs-service/Cargo.toml",
    "typecheck": "node apps/desktop/scripts/generate-settings.mjs && tsc -b --emitDeclarationOnly",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "tsc -b --clean",
    "start": "pnpm --filter @filejam/desktop start",
    "dev": "node apps/desktop/scripts/generate-settings.mjs && pnpm --filter @filejam/desktop dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
